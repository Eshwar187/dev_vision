# ==============================================================================
# DevVision AI — Production Frontend Dockerfile (Multi-Stage Build & Serve)
# ==============================================================================

# Stage 1: Build SvelteKit static / production build
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache curl

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run check && npm run build

# Stage 2: Minimal static / production runner
FROM node:20-alpine AS runner

WORKDIR /app

RUN apk add --no-cache curl

COPY frontend/package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/build ./build
COPY --from=builder /app/package.json ./

USER node

EXPOSE 3000

ENV PORT=3000 \
    HOST=0.0.0.0 \
    NODE_ENV=production

CMD ["node", "build"]
