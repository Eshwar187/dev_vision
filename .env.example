# ==============================================================================
# DevVision AI — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME=DevVision AI
SECRET_KEY=devvision_super_secret_dev_key_change_in_production_32chars_min
API_V1_STR=/api/v1

# Networking & CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]
HOST=0.0.0.0
PORT=8000

# PostgreSQL + pgvector
POSTGRES_USER=devvision
POSTGRES_PASSWORD=devvision_password
POSTGRES_DB=devvision
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devvision:devvision_password@localhost:5432/devvision
DATABASE_SYNC_URL=postgresql+psycopg2://devvision:devvision_password@localhost:5432/devvision

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# MinIO / S3-compatible Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=devvision-local
S3_REGION=us-east-1
S3_SECURE=false

# Authentication & Sessions
SESSION_COOKIE_NAME=devvision_session
CSRF_COOKIE_NAME=devvision_csrf
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# SvelteKit Public Environment
PUBLIC_API_BASE_URL=http://localhost:8000